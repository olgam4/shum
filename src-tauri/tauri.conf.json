{
  "productName": "SHUM",
  "version": "0.1.0",
  "identifier": "sh.anomaly.shum",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "fullscreen": true
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src * ws: wss: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "iOS": {
      "developmentTeam": "JGD5CLUNDD",
      "infoPlist": "./Info.ios.plist"
    }
  }
}
